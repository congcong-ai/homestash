# 独立 HomeStash 配置；禁止从 SmartBadge 拷贝凭据。
# 复制到 data/hardware/device.env 后填写；不向 Git 提交。
WIFI_SSID=
WIFI_PASSWORD=
# 可选常用路演热点，保留主网络、企业网络与屏幕保存的网络。
WIFI_ROADSHOW_SSID=
WIFI_ROADSHOW_PASSWORD=
# 可选企业 Wi-Fi；默认开启证书校验。
WIFI_OFFICE_SSID=
WIFI_OFFICE_USERNAME=
WIFI_OFFICE_IDENTITY=
WIFI_OFFICE_PASSWORD=
WIFI_OFFICE_DOMAIN=
WIFI_OFFICE_CA_FILE=
# Core 所在电脑的局域网地址，使用设备专用端口。
# Mac推荐使用 scutil --get LocalHostName 输出的名称：
# CORE_URL=http://你的Mac名称.local:3101（网络需支持mDNS和设备互访）
CORE_URL=http://192.168.1.100:3101
DEVICE_ID=freshmate-korvo-01
# 与 HomeStash 根 .env 的 DEVICE_TOKEN 相同；不是 AI API Key。
DEVICE_TOKEN=
# 烧录时必须绑定 USB 序列号与芯片 MAC；不得默认选择任意串口。
USB_SERIAL=
DEVICE_MAC=
