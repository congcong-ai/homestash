AI_PROVIDER=mock
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
DATABASE_PATH=./data/homestash.db
CORE_PORT=3100
# 真实语音：设置 bailian；AI_PROVIDER 改为 openai-compatible
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
SPEECH_PROVIDER=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
# 真实设备接口独立绑定；管理Core始终只监听回环地址
DEVICE_HOST=127.0.0.1
DEVICE_ID=freshmate-korvo-01
DEVICE_TOKEN=

# 图片识别使用的视觉模型，复用服务端 AI_BASE_URL / AI_API_KEY
AI_VISION_MODEL=qwen3-vl-plus

# 条码默认只查本地确认记录；设为 open-food-facts 后才向外部商品库发送条码。
PRODUCT_LOOKUP_PROVIDER=local

# 恢复前快照默认保存在数据库同级 backups/，可指定其他本机目录。
# BACKUP_DIRECTORY=data/backups

# 手机家庭局域网开发试用：运行 pnpm dev:lan，自动生成私有 data/lan/ 凭据。
# 多网卡时指定已连接的私有IPv4；默认自动选择，不填0.0.0.0。
# HOMESTASH_LAN_ADDRESS=192.168.1.10
# 可选起始端口：外部项目占用时自动选择后续空闲端口，以启动日志为准。
# WEB_PORT=3000
# DEVICE_PORT=3101
# 已配置 INTERNAL_LOGIN_ENABLED=true 时沿用现有完整账号配置。
# 不将LAN开发入口用于公网；正式部署使用HTTPS。
