diff --git a/imu-app/toolchain.cmake b/imu-app/toolchain.cmake
new file mode 100644
index 0000000..35f9054
--- /dev/null
+++ b/imu-app/toolchain.cmake
@@ -0,0 +1,24 @@
+# TuyaOpen 已设置主要编译参数；本文件补齐跨平台工具与 try_compile 上下文。
+# macOS 系统 ranlib 不能为 ARM ELF 静态库建立正确索引。
+if(NOT DEFINED TOOLCHAIN_DIR)
+  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
+    cmake_host_system_information(RESULT HS_HOST_ARCH QUERY OS_PLATFORM)
+    if(HS_HOST_ARCH MATCHES "arm64|aarch64")
+      set(HS_TOOLCHAIN_NAME "arm-gnu-toolchain-13.3.rel1-darwin-arm64-arm-none-eabi")
+    else()
+      set(HS_TOOLCHAIN_NAME "arm-gnu-toolchain-13.3.rel1-darwin-x86_64-arm-none-eabi")
+    endif()
+  else()
+    set(HS_TOOLCHAIN_NAME "gcc-arm-none-eabi-10.3-2021.10")
+  endif()
+  set(TOOLCHAIN_DIR "$ENV{HOMESTASH_TUYAOPEN_PATH}/platform/tools/${HS_TOOLCHAIN_NAME}")
+endif()
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR ARM)
+set(CMAKE_C_COMPILER "${TOOLCHAIN_DIR}/bin/arm-none-eabi-gcc")
+set(CMAKE_CXX_COMPILER "${TOOLCHAIN_DIR}/bin/arm-none-eabi-g++")
+set(CMAKE_AR "${TOOLCHAIN_DIR}/bin/arm-none-eabi-ar")
+set(CMAKE_RANLIB "${TOOLCHAIN_DIR}/bin/arm-none-eabi-ranlib" CACHE FILEPATH "ARM 静态库索引工具" FORCE)
+set(CMAKE_C_COMPILER_RANLIB "${CMAKE_RANLIB}" CACHE FILEPATH "ARM C 静态库索引工具" FORCE)
+set(CMAKE_CXX_COMPILER_RANLIB "${CMAKE_RANLIB}" CACHE FILEPATH "ARM C++ 静态库索引工具" FORCE)
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
