{
  "name": "homestash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @homestash/web typecheck",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && pnpm --filter @homestash/web build",
    "start:core": "tsx services/kitchen-core/src/main.ts",
    "start": "node scripts/dev.mjs --production",
    "format": "prettier --write apps packages services scripts tests",
    "hardware:build": "bash scripts/hardware/build.sh",
    "hardware:build:generic": "HOMESTASH_GENERIC_FIRMWARE=1 bash scripts/hardware/build.sh",
    "hardware:status": "node scripts/hardware/status.mjs",
    "server:install": "bash scripts/install-remote.sh",
    "server:deploy": "bash scripts/deploy-remote.sh",
    "server:ports": "python3 scripts/server-port-audit.py",
    "hardware:acceptance": "tsx scripts/hardware/accept-phase1.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@homestash/ai": "workspace:*",
    "@homestash/database": "workspace:*",
    "@homestash/domain": "workspace:*",
    "@homestash/protocol": "workspace:*",
    "@homestash/recipes": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "license": "MIT"
}
