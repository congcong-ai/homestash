CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 传感器与默认格式来自本地 Korvo 原厂 factory_demo。
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_640X480_15FPS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Korvo PSRAM半睡恢复触发IWDT，PoC保留PSRAM供电，优先验证可恢复的休眠。
# CONFIG_PM_SLP_SPIRAM_HALFSLEEP_ENABLED is not set
